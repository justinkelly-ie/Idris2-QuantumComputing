package FinSc-QuantumComputing
version = 0.1.0
authors = "Justin Kelly"
brief   = "Discrete Constructive Quantum Computing, Qubit Circuits, and Entanglement Engine."

depends = FinSc-Dihedron, FinSc-Geometry, FinSc-Multiset-Core, FinSc-Multiset-Transform, base, linear
sourcedir = "src"

modules = QuantumComputing,
          Quantum.Circuit,
          Quantum.DeutschJozsa,
          Quantum.DihedralChannels,
          Quantum.LandauerErasure,
          Quantum.NoCloning,
          Quantum.QuantumScaleTransforms,
          Quantum.Qubit,
          Quantum.Register,
          Quantum.StateStream,
          Quantum.Teleportation,
          Quantum.ToricCode


